# Create a Gemini API key at https://aistudio.google.com/app/apikey
# Keep this secret on the server. Never place it in HTML or JavaScript.
GEMINI_API_KEY=
# This model default follows Google's Gemini API generation documentation.
# If your key/project cannot access it, choose a supported text-generation model.
GEMINI_MODEL=gemini-3.8-flash
# Optional: adjust per-IP messages allowed per minute.
RATE_LIMIT_PER_MINUTE=18
